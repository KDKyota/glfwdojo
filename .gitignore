# ============================================================
# CMake
# ============================================================

# cmake --preset default で生成されるビルドディレクトリ
build/

# 自分用の計画ファイル
docs/plan.md

# マシンごとにパスが異なるため、各自のローカル設定は共有しない
# （CMakePresets.json を上書きするためのファイル）
CMakeUserPresets.json

# ============================================================
# Visual Studio
# ============================================================

# IDEのキャッシュとワークスペース設定（マシン固有のため除外）
.vs/
.vscode/
.zed/

.launch.vs.json

# ユーザーごとのローカルデバッグ設定
*.user
*.rsuser
*.suo
*.sln.docstates

# リソースコンパイラが自動生成するバイナリ（.rcのビルド中間ファイル）
*.aps

# obsidianの設定ディレクトリ
docs/.obsidian/

# clangd が生成するインデックスのキャッシュ
.cache/

# ============================================================
# 3Dモデル素材
# ============================================================

# LearnOpenGL 由来の 3D モデル。
# cyborg は "For Personal Use Only"、nanosuit は Crysis(Crytek) 由来、
# planet は TurboSquid 由来と、いずれも再配布が許諾されていない可能性が高いため
# リポジトリには含めない。必要な場合は LearnOpenGL の配布物から各自で取得すること。
resources/objects/

# ============================================================
# ログ・診断ファイル
# ============================================================

# ビルドログ（テキスト形式）
*.log

# MSBuild バイナリログ（VS の診断ログ）
*.binlog

.claude

# ============================================================
# Windows OS
# ============================================================

# エクスプローラーが自動生成するサムネイルキャッシュ
Thumbs.db

# フォルダの表示設定ファイル
[Dd]esktop.ini

# ゴミ箱フォルダ
$RECYCLE.BIN/
