# ============================================================
# CMake
# ============================================================

# cmake --preset default で生成されるビルドディレクトリ
build/

# マシンごとにパスが異なるため、各自のローカル設定は共有しない
# （CMakePresets.json を上書きするためのファイル）
CMakeUserPresets.json

# ============================================================
# Visual Studio
# ============================================================

# IDEのキャッシュとワークスペース設定（マシン固有のため除外）
.vs/

# ユーザーごとのローカルデバッグ設定
*.user
*.rsuser
*.suo
*.sln.docstates

# リソースコンパイラが自動生成するバイナリ（.rcのビルド中間ファイル）
*.aps

# obsidianの設定ディレクトリ
docs/.obsidian/

# ============================================================
# ログ・診断ファイル
# ============================================================

# ビルドログ（テキスト形式）
*.log

# MSBuild バイナリログ（VS の診断ログ）
*.binlog

# ============================================================
# Windows OS
# ============================================================

# エクスプローラーが自動生成するサムネイルキャッシュ
Thumbs.db

# フォルダの表示設定ファイル
[Dd]esktop.ini

# ゴミ箱フォルダ
$RECYCLE.BIN/
