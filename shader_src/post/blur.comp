// 横・縦を交互に呼んで2次元ブラーを近似する
// 隣接ピクセルは9タップのうち8個を共有するので、共有メモリに一度だけ載せて重複フェッチをなくす
#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2D srcImage;
layout(binding = 1, rgba16f) uniform writeonly image2D dstImage;

uniform bool horizontal;

const int TILE = 256; // local_size_x と一致させること
const int R = 4;      // 片側のタップ数。weight の要素数- 1

const float weight[5] = float[](0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162);

// 担当 + 左右のはみ出し(halo)
// 端のスレッドがグループ外を読むために必要
shared vec3 tile[TILE + 2 * R];

vec3 loadClamped(ivec2 coord, ivec2 size) {
    return imageLoad(srcImage, clamp(coord, ivec2(0), size - 1)).rgb;
}

void main() {
    const ivec2 size = imageSize(srcImage);
    const ivec2 dir = horizontal ? ivec2(1, 0) : ivec2(0, 1);

    // ワークグループはぼかす軸に沿って並ぶ
    // 垂直パスでは x/y の役割が入れ替わる
    const int along = int(gl_GlobalInvocationID.x);
    const int line = int(gl_WorkGroupID.y);
    const ivec2 pixel = horizontal ? ivec2(along, line) : ivec2(line, along);

    const int lid = int(gl_LocalInvocationID.x);
    tile[lid + R] = loadClamped(pixel, size);
    if (lid < R) {
        tile[lid] = loadClamped(pixel - dir * R, size);
        tile[lid + TILE + R] = loadClamped(pixel + dir * TILE, size);
    }

    // 全スレッドの書き込みを待たずに読むと、まだ書かれていない場所を拾う
    barrier();

    // barrier は全スレッドが通る必要があるので、範囲外の切り捨てはこの後で行う
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec3 result = tile[lid + R] * weight[0];
    for (int i = 1; i <= R; ++i)
        result += (tile[lid + R - i] + tile[lid + R + i]) * weight[i];

    imageStore(dstImage, pixel, vec4(result, 1.0));
}
